#!/usr/bin/env python3
from __future__ import annotations

import shutil
import sys
import sysconfig
from pathlib import Path


BACKUP_SUFFIX = ".bak-linux-setup"


def candidate_hint_files() -> list[Path]:
    candidates: list[Path] = []
    for key in ("platlib", "purelib"):
        path = sysconfig.get_paths().get(key)
        if path:
            candidates.append(Path(path) / "qutebrowser" / "browser" / "hints.py")
    candidates.extend(Path("/usr/lib").glob("python*/site-packages/qutebrowser/browser/hints.py"))
    candidates.extend(Path("/usr/lib").glob("python*/dist-packages/qutebrowser/browser/hints.py"))
    return [path for path in dict.fromkeys(candidates) if path.exists()]


def patch_hints(path: Path) -> bool:
    original = path.read_text(encoding="utf-8")
    if "Qt.WindowType.ToolTip" in original and "mapToGlobal(point)" in original:
        return False

    patched = original
    patched = patched.replace(
        "        super().__init__(parent=context.tab)\n"
        "        self._context = context\n"
        "        self.elem = elem\n",
        "        self._context = context\n"
        "        flags = (Qt.WindowType.ToolTip |\n"
        "                 Qt.WindowType.FramelessWindowHint |\n"
        "                 Qt.WindowType.WindowStaysOnTopHint)\n"
        "        super().__init__(parent=context.tab, flags=flags)\n"
        "        self.elem = elem\n",
        1,
    )
    patched = patched.replace(
        "        self.setTextFormat(Qt.TextFormat.RichText)\n",
        "        self.setTextFormat(Qt.TextFormat.RichText)\n"
        "        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating, True)\n",
        1,
    )
    patched = patched.replace(
        "        self.show()\n",
        "        self.show()\n"
        "        self.raise_()\n",
        1,
    )
    patched = patched.replace(
        "        self.move(rect.x(), rect.y())\n",
        "        point = rect.topLeft()\n"
        "        if self.isWindow():\n"
        "            point = self._context.tab.mapToGlobal(point)\n"
        "        self.move(point)\n",
        1,
    )

    if patched == original:
        raise RuntimeError(f"Could not find expected qutebrowser hint code in {path}")

    backup = path.with_name(path.name + BACKUP_SUFFIX)
    if not backup.exists():
        shutil.copy2(path, backup)
    path.write_text(patched, encoding="utf-8")
    return True


def main() -> int:
    paths = candidate_hint_files()
    if not paths:
        print("qutebrowser hints.py was not found", file=sys.stderr)
        return 1

    for path in paths:
        changed = patch_hints(path)
        status = "patched" if changed else "already patched"
        print(f"{status}: {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
