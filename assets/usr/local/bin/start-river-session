#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export XDG_SESSION_TYPE=wayland
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
export WLR_NO_HARDWARE_CURSORS=1
export GDK_BACKEND=wayland,x11
export QT_QPA_PLATFORM=wayland
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1

if command -v vmware-user-suid-wrapper >/dev/null 2>&1; then
    vmware-user-suid-wrapper >/dev/null 2>&1 &
fi

if [[ ! -x /usr/local/bin/river ]]; then
    echo "river is missing at /usr/local/bin/river"
    sleep 10
    exit 1
fi

if [[ ! -x /usr/local/bin/kwm ]]; then
    echo "kwm is missing at /usr/local/bin/kwm"
    sleep 10
    exit 1
fi

exec dbus-run-session /usr/local/bin/river -c /usr/local/bin/kwm
