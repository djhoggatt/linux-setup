#!/usr/bin/env bash
set -euo pipefail

if [ "$(systemd-detect-virt 2>/dev/null || true)" = "vmware" ]; then
    export GSK_RENDERER="${GSK_RENDERER:-cairo}"
fi

if [ "${1-}" = "+new-window" ]; then
    shift
    exec /usr/bin/ghostty --gtk-single-instance=false "$@"
fi

if [ "${1-}" = +* ]; then
    exec /usr/bin/ghostty "$@"
fi

exec /usr/bin/ghostty --gtk-single-instance=false "$@"
