configuration {
  modi: "drun,run,window";
  show-icons: false;
  terminal: "/usr/local/bin/ghostty";
  drun-display-format: "{name}";
}

* {
  font: "monospace 11";
}

window {
  transparency: "real";
  border: 2px;
  border-color: #88c0d0;
  border-radius: 10px;
  background-color: rgba(20, 23, 30, 0.92);
}

mainbox {
  children: [ "inputbar", "listview" ];
  spacing: 10px;
  padding: 12px;
}

inputbar {
  children: [ "prompt", "entry" ];
  spacing: 8px;
}

entry {
  padding: 8px;
}

listview {
  lines: 10;
  columns: 1;
  fixed-height: false;
}

element {
  padding: 8px;
  border-radius: 8px;
}

element selected {
  background-color: rgba(94, 129, 172, 0.5);
}
