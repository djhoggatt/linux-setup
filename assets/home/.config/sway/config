set $mod Mod4
set $term ghostty
set $menu rofi -show drun

font pango:Iosevka 11

seat * xcursor_theme Adwaita 24

# Physical monitor layout.
output HDMI-A-1 pos 0 0
output DP-1 pos 1920 0

default_border pixel 5
default_floating_border pixel 5
client.focused          #2e064f #2e064f #e6e6e6 #2e064f #2e064f
client.focused_inactive #101010 #101010 #e6e6e6 #101010 #101010
client.unfocused        #101010 #101010 #e6e6e6 #101010 #101010
client.urgent           #900000 #900000 #ffffff #900000 #900000

gaps inner 12
gaps outer 9
smart_gaps off

focus_follows_mouse yes
floating_modifier $mod normal

# Session startup
exec_always monitor-layout
exec_always wallpaper-rotate
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP SWAYSOCK
exec_always sh -c 'pkill -x waybar || true; exec waybar'

# Window rules
for_window [app_id="^$"] floating enable
for_window [app_id="zenity"] floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [app_id="com.mitchellh.ghostty"] border csd

# Workspaces.
set $ws1 1
set $ws2 2
set $ws3 3

# App launchers
bindsym $mod+Return exec $menu
bindsym $mod+t exec $term

# Basic window/session controls
bindsym $mod+l exec gtklock
bindsym $mod+Shift+l exit

# Screenshot
bindsym Print exec screenshot-region

# Volume
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioStop exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioPrev exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Focus iteration
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev

# Workspace navigation.
bindsym $mod+Up exec sway-workspace up
bindsym $mod+Down exec sway-workspace down
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3

# Output navigation.
bindsym $mod+Right focus output right
bindsym $mod+Left focus output left

# Move focused window between workspaces/outputs.
bindsym $mod+Shift+Down move container to workspace next_on_output
bindsym $mod+Shift+Up move container to workspace prev_on_output
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+Right move container to output right
bindsym $mod+Shift+Left move container to output left

# Layout approximations for float/grid/monocle modes.
bindsym $mod+f floating toggle
bindsym $mod+g layout toggle split
bindsym $mod+m fullscreen toggle

# Resize bindings.
bindsym $mod+Ctrl+Right resize grow width 10px
bindsym $mod+Ctrl+Left resize shrink width 10px
bindsym $mod+Ctrl+Down resize grow height 10px
bindsym $mod+Ctrl+Up resize shrink height 10px

include /etc/sway/config.d/*
