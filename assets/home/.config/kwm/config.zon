.{
    .background = null,

    .startup_cmds = .{
        .{ "monitor-layout" },
        .{ "wallpaper-rotate" },
    },

    .xcursor_theme = .{
        .theme = .{
            .name = "Adwaita",
            .size = 24,
        },
    },

    .bar = .{
        .show_default = true,
        .position = .top,
        .font = "monospace:size=10",
        .color = .{
            .normal = .{
                .fg = 0xe6e6e6ff,
                .bg = 0x000000ff,
            },
            .select = .{
                .fg = 0xe6e6e6ff,
                .bg = 0x1a1a1aff,
            },
        },
        .status = .stdin,
        .click = .{
            .status = .{
                .left = .{ .action = .{ .spawn = .{ .argv = .{ "bash", "-lc", "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -USR1 -f '^kwm-status-loop$'" } } } },
            },
        },
    },

    .tags = .{ "1", "2", "3", "4", "5", "6", "7", "8", "9" },

    .window_rules = .{
        .{ .app_id = .{ .str = "", .match_null = true }, .floating = true },
        .{ .app_id = .{ .str = "zenity" }, .floating = true },
        .{ .app_id = .{ .str = "xdg-desktop-portal-gtk" }, .floating = true },
        .{ .app_id = .{ .str = "ghostty" }, .is_terminal = true, .scroller_mfact = 0.8 },
    },

//    .default_layout = .float,
    .default_layout = .grid,
    .layout = .{
        .tile = .{
            .nmaster = 1,
            .mfact = 0.60,
            .inner_gap = 12,
            .outer_gap = 9,
            .master_location = .left,
        },
        .grid = .{
            .direction = .horizontal,
            .inner_gap = 12,
            .outer_gap = 9,
        },
        .monocle = .{
            .gap = 9,
        },
        .deck = .{
            .inner_gap = 12,
            .outer_gap = 9,
            .master_location = .left,
        },
        .scroller = .{
            .mfact = 0.75,
            .inner_gap = 16,
            .outer_gap = 9,
        },
    },

    .bindings = .{
        .key = .{
            .{
                .keysym = "Super_L",
                .modifiers = .{},
                .event = .{
                    .click = .{
                        .released = .{
                            .spawn = .{ .argv = .{ "rofi", "-show", "drun" } },
                        },
                    },
                },
            },
            .{
                .keysym = "Super_R",
                .modifiers = .{},
                .event = .{
                    .click = .{
                        .released = .{
                            .spawn = .{ .argv = .{ "rofi", "-show", "drun" } },
                        },
                    },
                },
            },
            .{
                .keysym = "Print",
                .modifiers = .{},
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "screenshot-region" } },
                        },
                    },
                },
            },
            .{
                .keysym = "XF86AudioRaiseVolume",
                .modifiers = .{},
                .event = .{
                    .repeat = .{
                        .spawn = .{ .argv = .{ "bash", "-lc", "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && pkill -USR1 -f '^kwm-status-loop$'" } },
                    },
                },
            },
            // VMware software keyboard remapping error.
            .{
                .keysym = "XF86AudioStop",
                .modifiers = .{},
                .event = .{
                    .repeat = .{
                        .spawn = .{ .argv = .{ "bash", "-lc", "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && pkill -USR1 -f '^kwm-status-loop$'" } },
                    },
                },
            },
            .{
                .keysym = "XF86AudioLowerVolume",
                .modifiers = .{},
                .event = .{
                    .repeat = .{
                        .spawn = .{ .argv = .{ "bash", "-lc", "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -USR1 -f '^kwm-status-loop$'" } },
                    },
                },
            },
            // VMware software keyboard remapping error.
            .{
                .keysym = "XF86AudioPrev",
                .modifiers = .{},
                .event = .{
                    .repeat = .{
                        .spawn = .{ .argv = .{ "bash", "-lc", "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -USR1 -f '^kwm-status-loop$'" } },
                    },
                },
            },
            .{
                .keysym = "XF86AudioMute",
                .modifiers = .{},
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "bash", "-lc", "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -USR1 -f '^kwm-status-loop$'" } },
                        },
                    },
                },
            },
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .forward },
                        },
                    },
                },
            },
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .reverse },
                        },
                    },
                },
            },
            .{
                .keysym = "Down",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .set_output_tag = .{ .tag = .{ .direction = .forward } } },
                    },
                },
            },
            .{
                .keysym = "Up",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .set_output_tag = .{ .tag = .{ .direction = .reverse } } },
                    },
                },
            },
            .{
                .keysym = "Right",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .focus_output_iter = .{ .direction = .forward } },
                    },
                },
            },
            .{
                .keysym = "Left",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .focus_output_iter = .{ .direction = .reverse } },
                    },
                },
            },
            .{
                .keysym = "Down",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .set_window_tag = .{ .tag = .{ .direction = .forward } } },
                    },
                },
            },
            .{
                .keysym = "Up",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .set_window_tag = .{ .tag = .{ .direction = .reverse } } },
                    },
                },
            },
            .{
                .keysym = "Right",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .send_to_output = .{ .direction = .forward } },
                    },
                },
            },
            .{
                .keysym = "Left",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{ .send_to_output = .{ .direction = .reverse } },
                    },
                },
            },
            .{ .keysym = "1", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1 } } } } } },
            .{ .keysym = "2", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10 } } } } } },
            .{ .keysym = "3", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100 } } } } } },
            .{ .keysym = "4", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1000 } } } } } },
            .{ .keysym = "5", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10000 } } } } } },
            .{ .keysym = "6", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100000 } } } } } },
            .{ .keysym = "7", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b1000000 } } } } } },
            .{ .keysym = "8", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b10000000 } } } } } },
            .{ .keysym = "9", .modifiers = .{ .ctrl = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b100000000 } } } } } },
            .{ .keysym = "1", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1 } } } } } },
            .{ .keysym = "2", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10 } } } } } },
            .{ .keysym = "3", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100 } } } } } },
            .{ .keysym = "4", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1000 } } } } } },
            .{ .keysym = "5", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10000 } } } } } },
            .{ .keysym = "6", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100000 } } } } } },
            .{ .keysym = "7", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b1000000 } } } } } },
            .{ .keysym = "8", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b10000000 } } } } } },
            .{ .keysym = "9", .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b100000000 } } } } } },
            .{
                .keysym = "f",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .switch_layout = .{ .layout = .float },
                        },
                    },
                },
            },
            .{
                .keysym = "g",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .switch_layout = .{ .layout = .grid },
                        },
                    },
                },
            },
            .{
                .keysym = "m",
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .switch_layout = .{ .layout = .monocle },
                        },
                    },
                },
            },
            .{
                .keysym = "l",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .horizontal = 10 } },
                    },
                },
            },
            .{
                .keysym = "h",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .horizontal = -10 } },
                    },
                },
            },
            .{
                .keysym = "j",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .vertical = 10 } },
                    },
                },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .ctrl = true, .mod1 = true, .shift = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .vertical = -10 } },
                    },
                },
            },
            .{
                .keysym = "space",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "rofi", "-show", "drun" } },
                        },
                    },
                },
            },
        },
        .pointer = .{
            .{
                .button = .left,
                .modifiers = .{ .ctrl = true, .mod1 = true },
                .event = .{ .pressed = .pointer_resize },
            },
        },
    },
}
