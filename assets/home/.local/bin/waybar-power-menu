#!/usr/bin/env python3
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk


LOGIN1_DEST = "org.freedesktop.login1"
LOGIN1_PATH = "/org/freedesktop/login1"
LOGIN1_IFACE = "org.freedesktop.login1.Manager"


def login1_call(method, parameters=None, reply_type=None):
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    return bus.call_sync(
        LOGIN1_DEST,
        LOGIN1_PATH,
        LOGIN1_IFACE,
        method,
        parameters,
        reply_type,
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )


def can(method):
    try:
        result = login1_call(method, reply_type=GLib.VariantType.new("(s)"))
    except GLib.Error:
        return False

    value = result.unpack()[0]
    return value == "yes"


def power_action(method):
    try:
        login1_call(method, GLib.Variant("(b)", (False,)))
    except GLib.Error as error:
        dialog = Gtk.MessageDialog(
            None,
            Gtk.DialogFlags.MODAL,
            Gtk.MessageType.ERROR,
            Gtk.ButtonsType.CLOSE,
            "Power action failed",
        )
        dialog.format_secondary_text(error.message)
        dialog.run()
        dialog.destroy()


def confirm_and_run(icon, title, message, method):
    dialog = Gtk.MessageDialog(
        None,
        Gtk.DialogFlags.MODAL,
        Gtk.MessageType.QUESTION,
        Gtk.ButtonsType.CANCEL,
        title,
    )
    dialog.set_icon_name(icon)
    dialog.format_secondary_text(message)
    dialog.add_button(title, Gtk.ResponseType.YES)
    dialog.set_default_response(Gtk.ResponseType.YES)

    response = dialog.run()
    dialog.destroy()

    if response == Gtk.ResponseType.YES:
        power_action(method)


def add_item(menu, label, sensitive, callback):
    item = Gtk.MenuItem(label=label)
    item.set_sensitive(sensitive)
    item.connect("activate", lambda *_: callback())
    menu.append(item)


def main():
    menu = Gtk.Menu()

    add_item(menu, "Suspend", can("CanSuspend"), lambda: power_action("Suspend"))
    add_item(menu, "Hibernate", can("CanHibernate"), lambda: power_action("Hibernate"))
    add_item(
        menu,
        "Restart...",
        can("CanReboot"),
        lambda: confirm_and_run(
            "view-refresh-symbolic",
            "Restart",
            "Are you sure you want to close all programs and restart the computer?",
            "Reboot",
        ),
    )
    add_item(
        menu,
        "Shut Down...",
        can("CanPowerOff"),
        lambda: confirm_and_run(
            "system-shutdown-symbolic",
            "Shut Down",
            "Are you sure you want to close all programs and shut down the computer?",
            "PowerOff",
        ),
    )

    menu.connect("deactivate", lambda *_: Gtk.main_quit())
    menu.show_all()
    menu.popup_at_pointer(None)
    Gtk.main()


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"waybar-power-menu: {error}", file=sys.stderr)
        sys.exit(1)
