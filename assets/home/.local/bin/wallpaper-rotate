#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="${1:-$HOME/backgrounds}"
last=""

ensure_wayland_display() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        return
    fi

    runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    candidate="$(find "$runtime_dir" -maxdepth 1 -type s -name 'wayland-*' | sort | tail -n 1)"
    if [ -z "$candidate" ]; then
        echo "could not determine WAYLAND_DISPLAY" >&2
        exit 1
    fi

    export XDG_RUNTIME_DIR="$runtime_dir"
    export WAYLAND_DISPLAY="$(basename "$candidate")"
}

start_daemon() {
    if pgrep -x awww-daemon >/dev/null 2>&1; then
        return
    fi

    awww-daemon >/dev/null 2>&1 &

    for _ in $(seq 1 50); do
        if awww query >/dev/null 2>&1; then
            return
        fi
        sleep 0.1
    done

    echo "awww-daemon did not become ready" >&2
    exit 1
}

pick_wallpaper() {
    find "$wallpaper_dir" -maxdepth 1 -type f \
        -size +0c \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        | shuf -n 1
}

ensure_wayland_display
start_daemon

while true; do
    mkdir -p "$wallpaper_dir"
    choice="$(pick_wallpaper || true)"

    if [ -n "$choice" ]; then
        if [ "$choice" = "$last" ]; then
            alt="$(pick_wallpaper || true)"
            if [ -n "$alt" ]; then
                choice="$alt"
            fi
        fi

        awww img "$choice"
        last="$choice"
    fi

    sleep 3600
done
