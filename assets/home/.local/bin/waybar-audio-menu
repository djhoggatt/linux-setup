#!/usr/bin/env python3
import re
import subprocess
import sys


def run(*argv, check=True):
    return subprocess.run(
        argv,
        check=check,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    ).stdout.strip()


def volume_label(value):
    try:
        return f"{round(float(value) * 100)}%"
    except ValueError:
        return value


def sinks_from_wpctl_status():
    sinks = []
    in_sinks = False
    for line in run("wpctl", "status").splitlines():
        if "├─ Sinks:" in line:
            in_sinks = True
            continue
        if in_sinks and "├─ Sources:" in line:
            break
        if not in_sinks:
            continue

        match = re.search(r"│\s*(\*)?\s*(\d+)\.\s+(.+?)\s+\[vol:\s+([^\]]+)\]", line)
        if not match:
            continue

        active, sink_id, name, volume = match.groups()
        sinks.append(
            {
                "id": sink_id,
                "name": name.strip(),
                "volume": volume_label(volume.strip()),
                "active": active == "*",
            }
        )
    return sinks


def node_name_for_id(node_id):
    for line in run("wpctl", "inspect", node_id).splitlines():
        match = re.search(r'node\.name = "([^"]+)"', line)
        if match:
            return match.group(1)
    return None


def move_active_streams(target_sink):
    inputs = run("pactl", "list", "short", "sink-inputs", check=False)
    for line in inputs.splitlines():
        parts = line.split()
        if parts:
            subprocess.run(
                ["pactl", "move-sink-input", parts[0], target_sink],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )


def choose_sink(sinks):
    choices = []
    display_to_sink = {}
    for sink in sinks:
        marker = "●" if sink["active"] else "○"
        display = f"{marker}  {sink['name']}    {sink['volume']}"
        choices.append(display)
        display_to_sink[display] = sink

    selection = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "Audio Output"],
        input="\n".join(choices),
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    ).stdout.strip()

    return display_to_sink.get(selection)


def main():
    sinks = sinks_from_wpctl_status()
    if not sinks:
        subprocess.run(["rofi", "-e", "No audio output devices found."], check=False)
        return 1

    sink = choose_sink(sinks)
    if sink is None:
        return 0

    run("wpctl", "set-default", sink["id"])
    node_name = node_name_for_id(sink["id"])
    if node_name:
        move_active_streams(node_name)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:
        print(f"waybar-audio-menu: {error}", file=sys.stderr)
        sys.exit(1)
