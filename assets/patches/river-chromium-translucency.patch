+
+    window.applyConfiguredOpacity();
+}
+
+fn isChromium(window: Window) bool {
+    const app_id = window.getAppId() orelse return false;
+    return std.ascii.eqlIgnoreCase(mem.span(app_id), "chromium");
+}
+
+fn configuredOpacity(window: Window) f32 {
+    return if (window.isChromium()) server.chromium_opacity else 1.0;
+}
+
+pub fn applyConfiguredOpacity(window: *Window) void {
+    const opacity = window.configuredOpacity();
+    applyOpacityToTree(window.surfaces.tree, opacity);
+    applyOpacityToTree(window.surfaces.saved_tree, opacity);
+    applyOpacityToTree(window.popup_tree, opacity);
+}
+
+fn applyOpacityToTree(tree: *wlr.SceneTree, opacity: f32) void {
+    var opacity_mut = opacity;
+    tree.node.forEachBuffer(*f32, applyOpacityToBuffer, &opacity_mut);
+}
+
+fn applyOpacityToBuffer(buffer: *wlr.SceneBuffer, _: c_int, _: c_int, opacity: *f32) void {
+    buffer.setOpacity(opacity.*);
+
+    if (opacity.* < 1.0) {
+        var region: pixman.Region32 = undefined;
+        region.init();
+        defer region.deinit();
+        buffer.setOpaqueRegion(&region);
+        return;
+    }
+
+    if (wlr.SceneSurface.tryFromBuffer(buffer)) |scene_surface| {
+        buffer.setOpaqueRegion(&scene_surface.surface.current.@"opaque");
+    }
 }
