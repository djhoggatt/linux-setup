+fn parseChromiumOpacity() f32 {
+    const raw_value = posix.getenv("RIVER_CHROMIUM_OPACITY") orelse return 1.0;
+    const value = mem.trim(u8, raw_value[0..], &std.ascii.whitespace);
+    if (value.len == 0) return 1.0;
+
+    var number = value;
+    var percent = false;
+    if (value[value.len - 1] == '%') {
+        percent = true;
+        number = mem.trimRight(u8, value[0 .. value.len - 1], &std.ascii.whitespace);
+        if (number.len == 0) return 1.0;
+    }
+
+    const parsed = std.fmt.parseFloat(f32, number) catch {
+        log.warn("invalid RIVER_CHROMIUM_OPACITY '{s}', falling back to 1.0", .{value});
+        return 1.0;
+    };
+
+    const opacity = if (percent or parsed > 1.0) parsed / 100.0 else parsed;
+    if (!math.isFinite(opacity) or opacity < 0.0 or opacity > 1.0) {
+        log.warn("RIVER_CHROMIUM_OPACITY '{s}' resolved outside 0.0-1.0, falling back to 1.0", .{value});
+        return 1.0;
+    }
+
+    return opacity;
+}
+
