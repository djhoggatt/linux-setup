--- a/river/Server.zig
+++ b/river/Server.zig
@@ -38,6 +38,39 @@ const XwaylandWindow = @import("XwaylandWindow.zig");
 
 const log = std.log;
 
+extern fn wlr_linux_dmabuf_v1_set_check_dmabuf_callback(
+    linux_dmabuf: *wlr.LinuxDmabufV1,
+    callback: *const fn (*wlr.DmabufAttributes, ?*anyopaque) callconv(.c) bool,
+    data: ?*anyopaque,
+) void;
+
+fn dmabufCheckCallback(attribs: *wlr.DmabufAttributes, data: ?*anyopaque) callconv(.c) bool {
+    const linux_dmabuf: *wlr.LinuxDmabufV1 = @ptrCast(@alignCast(data.?));
+    const linux_dmabuf_c: *c.struct_wlr_linux_dmabuf_v1 = @ptrCast(linux_dmabuf);
+    const main_device_fd = linux_dmabuf_c.WLR_PRIVATE.main_device_fd;
+
+    if (main_device_fd < 0) {
+        return true;
+    }
+
+    var i: usize = 0;
+    while (i < @as(usize, @intCast(attribs.n_planes))) : (i += 1) {
+        var handle: u32 = 0;
+        if (c.drmPrimeFDToHandle(main_device_fd, attribs.fd[i], &handle) != 0) {
+            return false;
+        }
+        if (c.drmCloseBufferHandle(main_device_fd, handle) != 0) {
+            // vmwgfx can reject this cleanup step with EINVAL even after the
+            // DMA-BUF import succeeded. wlroots treats that as fatal.
+            if (c.__errno_location().* != c.EINVAL) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
 wl_server: *wl.Server,
 
 sigint_source: *wl.EventSource,
